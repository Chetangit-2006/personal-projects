def generate_ai_response(message, profile):

    if not client:

        return (
            "AI API is not configured yet. "
            "However, I can still analyze your "
            "career profile using the built-in agents."
        )

    prompt = f"""
You are CareerAI, an intelligent career counselor.

Student Profile:
{profile.model_dump_json(indent=2)}

Student Question:
{message}

Give practical, personalized and concise career guidance.

Do not make absolute promises about jobs or salary.
Explain your reasoning clearly.
"""

    response = client.responses.create(
        model="gpt-4.1-mini",
        input=prompt
    )

  return response.output_text






const API = "http://127.0.0.1:8000";
let studentProfile = null;

// ------------------------------------------------
// START ASSESSMENT
// ------------------------------------------------

function startAssessment() {

    document
        .getElementById("assessment")
        .classList.remove("hidden");

    document
        .getElementById("assessment")
        .scrollIntoView({
            behavior: "smooth"
        });
}

// ------------------------------------------------
// FORM SUBMISSION
// ------------------------------------------------

document
    .getElementById("careerForm")
    .addEventListener("submit", async function(event) {

        event.preventDefault();

        const interests =
            document
                .getElementById("interests")
                .value
                .split(",")
                .map(x => x.trim())
                .filter(Boolean);


        const skillNames =
            document
                .getElementById("skills")
                .value
                .split(",")
                .map(x => x.trim())
                .filter(Boolean);
        const goals =
            document
                .getElementById("goals")
                .value
                .split(",")
                .map(x => x.trim())
                .filter(Boolean);
        const skills = {};

        skillNames.forEach(skill => {

            skills[skill] = 5;

        });

        studentProfile = {
            name:
                document.getElementById("name").value,

            education:
                document.getElementById("education").value,

            year:
                document.getElementById("year").value,

            interests,
            skills,
            goals

        };


        const button =
            event.target.querySelector("button");
        button.innerText =
            "AI Agents Analyzing...";

        button.disabled = true;
        try {

            const response =
                await fetch(
                    `${API}/api/analyze`,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body:
                            JSON.stringify(studentProfile)
                    }
                );
            const data =
                await response.json();

            showDashboard(data);

        } catch (error) {
            alert(
                "Could not connect to CareerAI backend. " +
                "Make sure FastAPI is running."
            );

            console.error(error);
        }

        button.innerText =
            "Analyze My Career 🚀";

        button.disabled = false;
    });


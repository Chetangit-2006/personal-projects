class CourseAgent:

    COURSES = {
        "Python": "Python Programming Fundamentals",
        "Statistics": "Statistics for Data Science",
        "Machine Learning": "Machine Learning Fundamentals",
        "Deep Learning": "Deep Learning with Neural Networks",
        "SQL": "SQL and Database Fundamentals",
        "Git": "Git and GitHub",
        "Networking": "Computer Networking Fundamentals",
        "Linux": "Linux Administration",
        "AWS": "AWS Cloud Fundamentals",
        "Docker": "Docker and Containers"
    }

    def recommend(self, missing_skills):

        courses = []

        for skill in missing_skills:

            if skill in self.COURSES:
                courses.append({
                    "skill": skill,
                    "course": self.COURSES[skill]
                })

        return courses
# -------------------------------------------------
# ROADMAP AGENT
# -------------------------------------------------

class RoadmapAgent:

    def create(self, missing_skills):

        roadmap = []

        for index, skill in enumerate(
            missing_skills,
            start=1
        ):

            roadmap.append({
                "week": index,
                "skill": skill,
                "task": f"Learn {skill} and complete one practical exercise."
            })

        return roadmap
# -------------------------------------------------
# PROGRESS AGENT
# -------------------------------------------------

class ProgressAgent:

    def update(self, roadmap, completed_weeks):

        total = len(roadmap)

        if total == 0:
            return 100

        percentage = (
            completed_weeks / total
        ) * 100

        return round(percentage)
# -------------------------------------------------
# ORCHESTRATOR
# -------------------------------------------------

class CareerOrchestrator:

    def __init__(self):

        self.profile_agent = ProfileAgent()
        self.career_agent = CareerAgent()
        self.skill_agent = SkillGapAgent()
        self.course_agent = CourseAgent()
        self.roadmap_agent = RoadmapAgent()

    def run(self, profile):

        # Agent 1
        profile_analysis = self.profile_agent.analyze(
            profile
        )

        # Agent 2
        careers = self.career_agent.recommend(
            profile
        )

        best_career = careers[0]["career"]

        # Agent 3
        skill_gap = self.skill_agent.analyze(
            profile,
            best_career
        )

        # Agent 4
        courses = self.course_agent.recommend(
            skill_gap["missing_skills"]
        )

        # Agent 5
        roadmap = self.roadmap_agent.create(
            skill_gap["missing_skills"]
        )

        return {
            "profile": profile_analysis,
            "careers": careers,
            "best_career": best_career,
            "skill_gap": skill_gap,
            "courses": courses,
            "roadmap": roadmap
        }
